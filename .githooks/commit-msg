#!/bin/sh
# Git Hook kiểm tra format commit message bắt buộc đi kèm Issue ID
# Định dạng yêu cầu: <type>(<scope>): <message> #<issue_id>
# Ví dụ: feat: add homepage #MP-01 hoặc fix: resolve login bug #102

commit_msg_file="$1"
commit_msg=$(cat "$commit_msg_file" | head -n 1)

# Bỏ qua merge commit hoặc revert commit
if echo "$commit_msg" | grep -qE '^(Merge|Revert)'; then
    exit 0
fi

# Biểu thức chính quy kiểm tra định dạng commit
# Type: feat|fix|hotfix|docs|style|refactor|test|chore
# Phải chứa #<id_issue> (ví dụ #MP-01, #123, #id_issue)
pattern="^(feat|fix|hotfix|docs|style|refactor|test|chore)(\([a-zA-Z0-9_-]+\))?: .+ #[a-zA-Z0-9_-]+"

if ! echo "$commit_msg" | grep -qE "$pattern"; then
    echo "===================================================================="
    echo "❌ COMMIT THẤT BẠI: Commit message không đúng quy chuẩn dự án!"
    echo "--------------------------------------------------------------------"
    echo "Commit hiện tại: \"$commit_msg\""
    echo ""
    echo "👉 Định dạng bắt buộc:"
    echo "   <type>(<scope>): <mô tả> #<id_issue>"
    echo ""
    echo "👉 Ví dụ hợp lệ:"
    echo "   feat: add homepage layout #MP-01"
    echo "   fix(auth): resolve token refresh loop #MP-102"
    echo "   hotfix: fix critical pulse stream error #MP-99"
    echo "===================================================================="
    exit 1
fi

exit 0
